<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>The Thornwood Chest</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Almendra:ital,wght@0,400;0,700;1,400&family=Alegreya:ital,wght@0,400;0,500;1,400&display=swap" rel="stylesheet">
<style>

  :root{
    --bark-deep:#1b110a;
    --cream:#efe4c8;
    --ink:#2a1709;
  }

  *{ box-sizing:border-box; }

  html{
    min-height:100%;
    background:
      radial-gradient(ellipse at 50% 40%, transparent 35%, rgba(0,0,0,0.55) 100%),
      repeating-linear-gradient(90deg, #2b1c11 0 118px, #1a0f08 118px 120px),
      var(--bark-deep);
  }

  body{
    min-height:100vh;
    margin:0;
    color:var(--ink);
    font-family:'Alegreya', Georgia, serif;
    display:flex;
    justify-content:center;
    padding:6vh 20px;
  }

  .scene{
    margin:auto 0;
    width:100%;
    max-width:500px;
    display:flex;
    flex-direction:column;
    align-items:center;
  }

  h1{
    font-family:'Almendra', serif;
    font-weight:700;
    font-size:clamp(1.8rem, 5vw, 2.5rem);
    letter-spacing:0.01em;
    color:var(--cream);
    margin:0 0 26px;
    text-align:center;
    text-shadow:0 2px 0 var(--bark-deep);
  }

  /* --- the note, resting on top of the book pile --- */
  .note-wrap{
    position:relative;
    z-index:2;
    width:86%;
    margin-bottom:-4%;
    transform:rotate(-1.6deg);
    filter:drop-shadow(0 4px 3px rgba(0,0,0,0.45));
  }

  .note{
    padding:34px 36px 30px;
    background:
      repeating-linear-gradient(180deg, transparent 0 31px, rgba(110,80,40,0.13) 31px 32px),
      radial-gradient(ellipse at 20% 10%, rgba(255,255,255,0.35), transparent 55%),
      #e4d3a8;
    clip-path:polygon(0 2%, 7% 0, 21% 1.5%, 37% 0, 55% 1.2%, 72% 0, 88% 1.5%, 100% 0, 99% 22%, 100% 46%, 98.5% 72%, 100% 100%, 83% 98.4%, 64% 100%, 45% 98.5%, 26% 100%, 10% 98.7%, 0 100%, 1.2% 76%, 0 50%, 1% 25%);
  }

  .note p{
    font-size:1.18rem;
    line-height:32px;
    margin:0 0 32px;
    max-width:40ch;
  }
  .note p:last-of-type{ margin-bottom:0; }

  .note .sign{
    font-family:'Almendra', serif;
    font-style:italic;
    font-size:1.25rem;
    text-align:right;
    margin:32px 0 0;
  }

  /* --- the book pile --- */
  .books{
    display:block;
    width:100%;
    height:auto;
    overflow:visible;
  }

  @media (max-width:420px){
    .note{ padding:30px 24px 26px; }
    .note-wrap{ width:92%; }
  }
</style>
</head>
<body>

<main class="scene">

  <h1>The Thornwood Chest</h1>

  <div class="note-wrap">
    <article class="note">

      <!-- ===== EDIT YOUR MESSAGE BELOW ===== -->
      <p>The lid is up and the roots have let go. You spoke the right words.</p>

      <p>Replace this with whatever you want to say. Add or remove paragraphs as needed; each one sits on its own ruled line of the note.</p>

      <p class="sign">Your name here</p>
      <!-- ===== END OF MESSAGE ===== -->

    </article>
  </div>

  <svg class="books" viewBox="0 0 400 240" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="A leaning pile of old fairytale books wrapped in vines, with toadstools at its base">

    <ellipse cx="200" cy="234" rx="196" ry="8" fill="#000" opacity="0.4"/>

    <!-- book 1: burgundy, spine out -->
    <g transform="rotate(-0.6 200 209)">
      <rect x="12" y="186" width="376" height="46" rx="4" fill="#6a2c3a" stroke="#1b110a" stroke-width="3"/>
      <g fill="#c79a45">
        <rect x="32" y="187.5" width="5" height="43"/><rect x="40" y="187.5" width="2" height="43"/>
        <rect x="363" y="187.5" width="5" height="43"/><rect x="358" y="187.5" width="2" height="43"/>
      </g>
      <g fill="none" stroke="#c79a45" stroke-width="1.6">
        <path d="M200 196 L212 209 L200 222 L188 209 Z"/>
        <path d="M66 209 H172" opacity="0.7"/><path d="M228 209 H334" opacity="0.7"/>
      </g>
      <circle cx="200" cy="209" r="2.4" fill="#c79a45"/>
      <path d="M14 229 H386" stroke="#3d1621" stroke-width="2"/>
    </g>

    <!-- book 2: green cover, page edges out -->
    <g transform="rotate(0.8 200 166)">
      <rect x="34" y="146" width="332" height="40" fill="#e4d3a8"/>
      <g stroke="#b39a68" stroke-width="1">
        <path d="M40 156 H362"/><path d="M40 161 H362"/><path d="M40 166 H362"/>
        <path d="M40 171 H362"/><path d="M40 176 H362"/>
      </g>
      <rect x="34" y="146" width="332" height="6" fill="#2f4a35"/>
      <rect x="34" y="180" width="332" height="6" fill="#2f4a35"/>
      <rect x="28" y="146" width="10" height="40" rx="2" fill="#2f4a35"/>
      <rect x="34" y="146" width="332" height="40" fill="none" stroke="#1b110a" stroke-width="3"/>
    </g>

    <!-- book 3: blue-grey, spine out -->
    <g transform="rotate(-1 190 124)">
      <rect x="52" y="102" width="296" height="44" rx="4" fill="#35596a" stroke="#1b110a" stroke-width="3"/>
      <g fill="#c79a45">
        <rect x="72" y="103.5" width="5" height="41"/><rect x="80" y="103.5" width="2" height="41"/>
        <rect x="323" y="103.5" width="5" height="41"/><rect x="318" y="103.5" width="2" height="41"/>
      </g>
      <g fill="none" stroke="#c79a45" stroke-width="1.6">
        <circle cx="200" cy="124" r="10"/>
        <path d="M104 124 H182" opacity="0.7"/><path d="M218 124 H296" opacity="0.7"/>
      </g>
      <path d="M200 117 L202 122 L207 124 L202 126 L200 131 L198 126 L193 124 L198 122 Z" fill="#c79a45"/>
    </g>

    <!-- book 4: plum cover, page edges out -->
    <g transform="rotate(1.2 200 86)">
      <rect x="72" y="70" width="262" height="32" fill="#e4d3a8"/>
      <g stroke="#b39a68" stroke-width="1">
        <path d="M78 78 H330"/><path d="M78 83 H330"/><path d="M78 88 H330"/><path d="M78 93 H330"/>
      </g>
      <rect x="72" y="70" width="262" height="5" fill="#523a63"/>
      <rect x="72" y="97" width="262" height="5" fill="#523a63"/>
      <rect x="66" y="70" width="10" height="32" rx="2" fill="#523a63"/>
      <rect x="72" y="70" width="262" height="32" fill="none" stroke="#1b110a" stroke-width="3"/>
    </g>

    <!-- book 5: small ochre book on top -->
    <g transform="rotate(-1.6 200 52)">
      <rect x="98" y="34" width="204" height="36" rx="4" fill="#a8742f" stroke="#1b110a" stroke-width="3"/>
      <g fill="#3a2412">
        <rect x="116" y="35.5" width="4" height="33"/><rect x="280" y="35.5" width="4" height="33"/>
      </g>
      <g fill="none" stroke="#3a2412" stroke-width="1.6">
        <path d="M200 40 Q212 52 200 64 Q188 52 200 40 Z"/>
        <path d="M134 52 H180" opacity="0.8"/><path d="M220 52 H266" opacity="0.8"/>
      </g>
    </g>

    <!-- moss on the top book -->
    <g fill="#5f7a3a" stroke="#2f3f1b" stroke-width="1.5">
      <path d="M262 36 q6 -10 15 -3 q8 -8 15 2 q5 2 5 7 q-18 4 -35 -1 Z"/>
    </g>

    <!-- vine up the left side -->
    <path d="M16 232 Q0 214 14 196 Q26 180 10 162 Q-2 146 14 130" fill="none" stroke="#3f5526" stroke-width="3.2" stroke-linecap="round"/>
    <g fill="#6c8a41" stroke="#2f3f1b" stroke-width="1.2">
      <path d="M8 214 q-14 -4 -18 6 q10 8 18 -6 Z"/>
      <path d="M20 190 q14 -8 22 2 q-8 10 -22 -2 Z"/>
      <path d="M8 164 q-12 -8 -20 0 q8 10 20 0 Z"/>
      <path d="M16 138 q14 -6 20 4 q-10 8 -20 -4 Z"/>
    </g>
    <g>
      <circle cx="-6" cy="206" r="3.2" fill="#e8c8d4"/><circle cx="-6" cy="206" r="1.2" fill="#c79a45"/>
      <circle cx="40" cy="186" r="3.2" fill="#e8c8d4"/><circle cx="40" cy="186" r="1.2" fill="#c79a45"/>
    </g>

    <!-- toadstools at the right foot -->
    <g>
      <path d="M392 238 L392 224 Q392 220 396 220 Q400 220 400 224 L400 238 Z" fill="#e9dcc0" stroke="#1b110a" stroke-width="1.5"/>
      <path d="M380 224 Q380 206 396 206 Q412 206 412 224 Z" fill="#9a4a63" stroke="#1b110a" stroke-width="2"/>
      <circle cx="390" cy="215" r="2.2" fill="#efe4c8"/><circle cx="402" cy="213" r="2" fill="#efe4c8"/><circle cx="397" cy="220" r="1.4" fill="#efe4c8"/>
    </g>
    <g>
      <path d="M368 238 L368 231 Q368 228 371 228 Q374 228 374 231 L374 238 Z" fill="#e9dcc0" stroke="#1b110a" stroke-width="1.5"/>
      <path d="M360 231 Q360 220 371 220 Q382 220 382 231 Z" fill="#c79a45" stroke="#1b110a" stroke-width="2"/>
      <circle cx="367" cy="226" r="1.4" fill="#efe4c8"/><circle cx="376" cy="225" r="1.4" fill="#efe4c8"/>
    </g>
    <g fill="none" stroke="#5f7a3a" stroke-width="2.5" stroke-linecap="round">
      <path d="M60 236 q-4 -12 -8 -16"/><path d="M64 236 q0 -14 -1 -20"/><path d="M68 236 q4 -10 8 -14"/>
    </g>
  </svg>

</main>

</body>
</html>
